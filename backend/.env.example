# Copy these values into backend/.env to enable email notifications.
# Leave SMTP_HOST empty to keep email delivery disabled.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=Vakilo
SMTP_USE_TLS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vakilo-demo-mu.vercel.app
